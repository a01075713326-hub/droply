export type BadgeState = "ok" | "warn" | "unknown";

type Tone = "neutral" | "ok" | "warn";

type Badge = {
  label: string;
  value: string;
  tone: Tone;
};

export default function ProjectBadges({
  difficulty,
  cost,
  chain,
  audit,
  contract,
}: {
  difficulty?: string;
  cost?: string;
  chain: string;
  /** "ok" = audit found, "warn" = none found, "unknown" = not checked */
  audit: BadgeState;
  /** "ok" = contract verified, "warn" = not verified, "unknown" = no contract on file */
  contract: BadgeState;
}) {
  const badges: Badge[] = [
    {
      label: "Difficulty",
      value: difficulty || "Unknown",
      tone: "neutral",
    },
    {
      label: "Cost",
      value: cost || "Unknown",
      tone: "neutral",
    },
    {
      label: "Blockchain",
      value: chain,
      tone: "neutral",
    },
    audit === "ok"
      ? { label: "Security", value: "Audited", tone: "ok" as Tone }
      : {
          label: audit === "warn" ? "Warning" : "Audit",
          value: audit === "warn" ? "No audit" : "Not checked",
          tone: audit === "warn" ? ("warn" as Tone) : ("neutral" as Tone),
        },
    contract === "ok"
      ? { label: "Contract", value: "Verified", tone: "ok" as Tone }
      : {
          label: contract === "warn" ? "Unverified" : "Contract",
          value: contract === "warn" ? "No contract" : "Not checked",
          tone: contract === "warn" ? ("warn" as Tone) : ("neutral" as Tone),
        },
  ];

  return (
    <div className="badges-row">
      {badges.map((b) => (
        <div key={b.label + b.value} className={`badge-item badge-item--${b.tone}`}>
          <span className="badge-item-label">{b.label}</span>
          <span className="badge-item-value">{b.value}</span>
        </div>
      ))}
    </div>
  );
}
